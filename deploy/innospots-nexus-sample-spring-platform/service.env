# innospots-nexus-sample-spring-platform 部署参数（被同目录脚本 source）

DEPLOY_APP_SLUG="spring-platform"
DEPLOY_APP_BASE="${DEPLOY_APP_BASE:-/opt/innospots/nexus-sample-spring-platform}"

PACKAGE_NAME="innospots-nexus-sample-spring-platform"
MVN_MODULE="innospots-nexus-sample/innospots-nexus-sample-spring-platform"

# Jersey filter 下 /actuator/health 常为 404；用控制台 OpenAPI catalog 探活
DEPLOY_HEALTH_URL="http://127.0.0.1:8082/openapi/specs"
DEPLOY_STARTUP_PROFILE="local"

# 可选覆盖
# INNOSPOTS_DEPLOY_BASE=/opt/innospots
# DEPLOY_DIST_DIR=<repo>/innospots-nexus-sample/dist
# GITHUB_SHA=<release-id>
