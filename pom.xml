<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.innospots</groupId>
    <artifactId>innospots-nexus</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>

    <name>innospots-nexus</name>
    <description>Lightweight AI enterprise platform foundation.</description>
    <url>https://github.com/innospots/innospots-nexus</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>Innospots Team</name>
            <organization>Innospots</organization>
            <organizationUrl>https://github.com/innospots</organizationUrl>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/innospots/innospots-nexus.git</connection>
        <developerConnection>scm:git:ssh://git@github.com:innospots/innospots-nexus.git</developerConnection>
        <url>https://github.com/innospots/innospots-nexus</url>
    </scm>

    <modules>
        <module>innospots-nexus-bom</module>
        <module>innospots-nexus-parent</module>
        <module>innospots-nexus-base</module>
        <module>innospots-nexus-service</module>
        <module>innospots-nexus-core</module>
        <module>innospots-nexus-plugin</module>
        <module>innospots-nexus-console</module>
        <module>innospots-nexus-portal</module>
        <module>innospots-nexus-platform</module>
        <module>innospots-nexus-spring</module>
        <module>innospots-nexus-quarkus</module>
        <module>innospots-nexus-sample</module>
    </modules>

    <properties>
        <revision>0.1.0-SNAPSHOT</revision>
        <innospots.version>${revision}</innospots.version>
        <flatten-maven-plugin.version>1.7.3</flatten-maven-plugin.version>
        <central-publishing-maven-plugin.version>0.11.0</central-publishing-maven-plugin.version>
        <maven-gpg-plugin.version>3.2.8</maven-gpg-plugin.version>
        <innospots.maven.central.serverId>central-repo</innospots.maven.central.serverId>
        <innospots.maven.dev.repository.url>https://packages.aliyun.com/693b57fbc9f33056ad3d893a/maven/2629969-snapshot-mzt5q6</innospots.maven.dev.repository.url>
        <innospots.maven.central.release.repository.url>https://ossrh-staging-api.central.sonatype.com/service/local/staging/deploy/maven2/</innospots.maven.central.release.repository.url>
        <innospots.maven.central.snapshot.repository.url>https://central.sonatype.com/repository/maven-snapshots/</innospots.maven.central.snapshot.repository.url>
    </properties>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>flatten-maven-plugin</artifactId>
                    <version>${flatten-maven-plugin.version}</version>
                    <configuration>
                        <flattenMode>resolveCiFriendliesOnly</flattenMode>
                        <updatePomFile>true</updatePomFile>
                    </configuration>
                    <executions>
                        <execution>
                            <id>flatten</id>
                            <phase>process-resources</phase>
                            <goals>
                                <goal>flatten</goal>
                            </goals>
                        </execution>
                        <execution>
                            <id>flatten-clean</id>
                            <phase>clean</phase>
                            <goals>
                                <goal>clean</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>dev</id>
            <distributionManagement>
                <repository>
                    <id>dev-repo</id>
                    <name>snapshot-MZt5q6</name>
                    <url>${innospots.maven.dev.repository.url}</url>
                </repository>
                <snapshotRepository>
                    <id>dev-repo</id>
                    <name>snapshot-MZt5q6</name>
                    <url>${innospots.maven.dev.repository.url}</url>
                </snapshotRepository>
            </distributionManagement>
        </profile>
        <profile>
            <id>central</id>
            <distributionManagement>
                <repository>
                    <id>central-repo</id>
                    <name>Sonatype Central Release</name>
                    <url>${innospots.maven.central.release.repository.url}</url>
                </repository>
                <snapshotRepository>
                    <id>central-repo</id>
                    <name>Sonatype Central Snapshot</name>
                    <url>${innospots.maven.central.snapshot.repository.url}</url>
                </snapshotRepository>
            </distributionManagement>
        </profile>
        <profile>
            <id>central-publish</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>${maven-gpg-plugin.version}</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>${central-publishing-maven-plugin.version}</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>${innospots.maven.central.serverId}</publishingServerId>
                            <autoPublish>false</autoPublish>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
